{
	"name": "om-pi-subagents",
	"version": "0.3.0",
	"description": "Opinionated Modular Pi Subagents System (OMPSS): YAML-mapped personas run as native Pi child processes.",
	"keywords": [
		"ompss",
		"opinionated",
		"pi-extension",
		"pi-package",
		"subagents"
	],
	"homepage": "https://github.com/cmdaltctr/om-pi-subagents#readme",
	"bugs": {
		"url": "https://github.com/cmdaltctr/om-pi-subagents/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cmdaltctr/om-pi-subagents.git"
	},
	"files": [
		"src",
		"skills/om-pi-subagents/SKILL.md",
		"docs/assets/om-pi-subagents-logo.svg",
		"docs/INSTALL.md",
		"docs/SETUP.md",
		"docs/USAGE.md",
		"docs/UNINSTALL.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"setup:host": "./scripts/setup-host.sh",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"audit": "bun audit --prod && bun audit --ignore GHSA-vfj7-8cjw-p6xm",
		"ci": "bun run format:check && bun run lint && bun run typecheck && bun run test",
		"ci:clean": "./scripts/ci-clean.sh",
		"prepare": "husky || true"
	},
	"dependencies": {
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@fission-ai/openspec": "1.14.0",
		"@types/node": "^26.6.3",
		"husky": "^9.1.7",
		"om-pi-todo": "0.2.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
